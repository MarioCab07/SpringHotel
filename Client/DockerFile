# ================================
# 1. Build del frontend (Vite + Yarn)
# ================================
FROM node:20-alpine AS build

WORKDIR /app

# Copiamos dependencias
COPY package.json yarn.lock ./
RUN yarn install

# Copiamos el resto del front
COPY . .

# Creamos la build de producción
RUN yarn build


# ================================
# 2. Nginx: servidor para la web final
# ================================
FROM nginx:alpine

WORKDIR /usr/share/nginx/html

# Copiamos el build (dist/)
COPY --from=build /app/dist ./

# Copiamos config.json inicial al destino exacto
COPY public/config.json ./config.json

# Copiamos configuración personalizada de nginx
COPY nginx.conf /etc/nginx/nginx.conf

EXPOSE 80

# Railway reemplazará este comando por uno dinámico si queremos sobrescribir config.json
CMD ["nginx", "-g", "daemon off;"]
